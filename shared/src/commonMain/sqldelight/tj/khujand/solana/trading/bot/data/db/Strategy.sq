CREATE TABLE IF NOT EXISTS strategy (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 0,
    timeframe TEXT NOT NULL DEFAULT '1m',

    -- Размер позиции и исполнение (DEX)
    position_size REAL NOT NULL DEFAULT 5.0,
    max_positions INTEGER NOT NULL DEFAULT 1,
    slippage_percent REAL NOT NULL DEFAULT 1.0,
    priority_fee_lamports INTEGER NOT NULL DEFAULT 0,

    -- Stop Loss / Take Profit
    stop_loss_percent REAL NOT NULL DEFAULT 15.0,
    take_profit_percent REAL NOT NULL DEFAULT 30.0,
    trailing_stop INTEGER NOT NULL DEFAULT 0,
    trailing_stop_percent REAL NOT NULL DEFAULT 10.0,
    trailing_activation_percent REAL NOT NULL DEFAULT 15.0,
    break_even_enabled INTEGER NOT NULL DEFAULT 0,
    break_even_trigger_percent REAL NOT NULL DEFAULT 10.0,
    break_even_offset_percent REAL NOT NULL DEFAULT 1.0,
    partial_tp_enabled INTEGER NOT NULL DEFAULT 0,
    tp1_percent REAL NOT NULL DEFAULT 15.0,
    tp1_close_percent REAL NOT NULL DEFAULT 50.0,
    tp2_percent REAL NOT NULL DEFAULT 25.0,
    tp2_close_percent REAL NOT NULL DEFAULT 30.0,
    -- DEX-специфика: принудительный выход по времени и по падению ликвидности пула
    time_stop_minutes INTEGER NOT NULL DEFAULT 0,
    liquidity_exit_drop_percent REAL NOT NULL DEFAULT 50.0,

    -- Риск
    max_daily_loss REAL NOT NULL DEFAULT 5.0,
    -- Должен быть заметно БОЛЬШЕ stop_loss_percent, иначе обычный стоп-лосс
    -- сам по себе перекрывает лимит просадки и блокирует стратегию.
    max_drawdown REAL NOT NULL DEFAULT 30.0,
    cooldown_seconds INTEGER NOT NULL DEFAULT 300,

    -- Фильтры токенов (сканер мемкоинов)
    min_liquidity_usd REAL NOT NULL DEFAULT 10000.0,
    min_market_cap REAL NOT NULL DEFAULT 50000.0,
    max_market_cap REAL NOT NULL DEFAULT 10000000.0,
    min_token_age_minutes INTEGER NOT NULL DEFAULT 30,
    max_token_age_minutes INTEGER NOT NULL DEFAULT 43200,

    -- Фильтр по позиции цены в диапазоне (общий для всех стратегий; спот → только «не покупать у верха»)
    range_filter_enabled INTEGER NOT NULL DEFAULT 0,
    range_max_entry_pct REAL NOT NULL DEFAULT 0.8,
    range_lookback_bars INTEGER NOT NULL DEFAULT 100,

    -- Вход по баллу (стратегия SCORE): порог балла + выключатель фильтров сканера
    score_threshold INTEGER NOT NULL DEFAULT 50,
    scan_filters_enabled INTEGER NOT NULL DEFAULT 1,

    -- Выключатели риск-лимитов (поздние колонки, пишутся updateRiskToggles):
    -- 0 = соответствующий лимит не блокирует вход. DEFAULT 1 — прежнее поведение.
    max_daily_loss_enabled INTEGER NOT NULL DEFAULT 1,
    max_drawdown_enabled INTEGER NOT NULL DEFAULT 1,

    -- Индикаторы (ATR — стоп «Пробой + откат» и ATR-трейлинг). Колонки RSI/EMA/порога объёма
    -- удалены вместе со стратегиями Momentum и RSI+EMA; в старых БД они остаются с DEFAULT и не мешают.
    atr_period INTEGER NOT NULL DEFAULT 14,

    -- Dars / Smart Money (параметры входа по свечной структуре)
    dars_higher_tf TEXT NOT NULL DEFAULT '15m',
    dars_candle_limit INTEGER NOT NULL DEFAULT 200,
    dars_swing_pivot_pct REAL NOT NULL DEFAULT 1.0,
    dars_require_htf_trend INTEGER NOT NULL DEFAULT 1,
    dars_dominance_ratio REAL NOT NULL DEFAULT 1.5,
    dars_min_correction_len_pct REAL NOT NULL DEFAULT 70.0,
    dars_reject_at_resistance INTEGER NOT NULL DEFAULT 1,
    dars_resistance_proximity_pct REAL NOT NULL DEFAULT 1.0,
    dars_min_legs INTEGER NOT NULL DEFAULT 4,
    dars_use_impulse_correction INTEGER NOT NULL DEFAULT 1,
    dars_use_trend_levels INTEGER NOT NULL DEFAULT 1,
    dars_use_false_breakout INTEGER NOT NULL DEFAULT 1,
    dars_use_triangle INTEGER NOT NULL DEFAULT 1,

    -- Выходы в R (поздние колонки, пишутся updateExitParams). DEFAULT 0 — прежнее поведение.
    r_ladder_enabled INTEGER NOT NULL DEFAULT 0,
    tp1_r REAL NOT NULL DEFAULT 1.5,
    tp2_r REAL NOT NULL DEFAULT 3.0,
    break_even_after_tp1 INTEGER NOT NULL DEFAULT 0,
    runner_enabled INTEGER NOT NULL DEFAULT 0,
    atr_trail_enabled INTEGER NOT NULL DEFAULT 0,
    atr_trail_mult REAL NOT NULL DEFAULT 3.0,
    atr_trail_activation_r REAL NOT NULL DEFAULT 1.0,

    -- Размер позиции от риска (поздние колонки, пишутся updateSizingParams). DEFAULT 0 — % баланса.
    risk_sizing_enabled INTEGER NOT NULL DEFAULT 0,
    risk_per_trade_percent REAL NOT NULL DEFAULT 1.0,
    max_pool_share_percent REAL NOT NULL DEFAULT 1.0,

    -- Пробой + откат (стратегия BREAKOUT_PULLBACK; поздние колонки, пишутся updateBreakoutParams)
    bp_higher_tf TEXT NOT NULL DEFAULT '15m',
    bp_require_htf_trend INTEGER NOT NULL DEFAULT 1,
    bp_breakout_lookback INTEGER NOT NULL DEFAULT 20,
    bp_breakout_volume_mult REAL NOT NULL DEFAULT 2.0,
    bp_max_bars_since_breakout INTEGER NOT NULL DEFAULT 20,
    bp_pullback_volume_ratio REAL NOT NULL DEFAULT 0.7,
    bp_trigger_volume_mult REAL NOT NULL DEFAULT 1.2,

    -- Выходы «по иксам» (общие; поздние колонки, пишутся updateTieredExitParams). DEFAULT 0 — выключены.
    tiered_trail_enabled INTEGER NOT NULL DEFAULT 0,
    trail_tier1_pct REAL NOT NULL DEFAULT 40.0,
    trail_tier2_pct REAL NOT NULL DEFAULT 30.0,
    trail_tier3_pct REAL NOT NULL DEFAULT 20.0,
    trail_tier4_pct REAL NOT NULL DEFAULT 15.0,
    stale_exit_enabled INTEGER NOT NULL DEFAULT 0,
    stale_exit_minutes INTEGER NOT NULL DEFAULT 1440,

    -- Мем-плейбук (стратегия MEME_PLAYBOOK; поздние колонки, пишутся updateMemeParams)
    mp_lookback_bars INTEGER NOT NULL DEFAULT 72,
    mp_min_impulse_pct REAL NOT NULL DEFAULT 50.0,
    mp_fib_min REAL NOT NULL DEFAULT 0.382,
    mp_fib_max REAL NOT NULL DEFAULT 0.786,
    mp_pullback_volume_ratio REAL NOT NULL DEFAULT 0.7,
    mp_trigger_volume_mult REAL NOT NULL DEFAULT 1.2,
    mp_min_liq_to_mc_pct REAL NOT NULL DEFAULT 3.0,
    mp_require_revoked_authorities INTEGER NOT NULL DEFAULT 1,
    mp_reject_copycats INTEGER NOT NULL DEFAULT 1,

    -- Волны Эллиотта (стратегия ELLIOTT; поздние колонки, пишутся updateElliottParams)
    ew_higher_tf TEXT NOT NULL DEFAULT '1h',
    ew_require_htf INTEGER NOT NULL DEFAULT 0,
    ew_swing_atr REAL NOT NULL DEFAULT 2.5,
    ew_sub_degree REAL NOT NULL DEFAULT 0.382,
    ew_structure TEXT NOT NULL DEFAULT 'SOFT',
    ew_trade_wave3 INTEGER NOT NULL DEFAULT 1,
    ew_trade_wave5 INTEGER NOT NULL DEFAULT 1,
    ew_trade_correction INTEGER NOT NULL DEFAULT 0,
    ew_w2_retrace_min REAL NOT NULL DEFAULT 0.382,
    ew_w2_retrace_max REAL NOT NULL DEFAULT 0.786,
    ew_w4_retrace_min REAL NOT NULL DEFAULT 0.236,
    ew_w4_retrace_max REAL NOT NULL DEFAULT 0.5,
    ew_min_guidelines INTEGER NOT NULL DEFAULT 2,
    ew_wave3_entry TEXT NOT NULL DEFAULT 'BREAK',
    ew_entry_window_bars INTEGER NOT NULL DEFAULT 3,
    ew_stop_anchor TEXT NOT NULL DEFAULT 'RULE',
    ew_stop_buffer_atr REAL NOT NULL DEFAULT 0.2,
    ew_w3_target REAL NOT NULL DEFAULT 1.618,
    ew_w5_target REAL NOT NULL DEFAULT 1.0,
    ew_min_reward_risk REAL NOT NULL DEFAULT 1.5,

    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

getAll:
SELECT * FROM strategy;

getActiveStrategies:
SELECT * FROM strategy WHERE is_active = 1;

getById:
SELECT * FROM strategy WHERE id = ?;

insert:
INSERT INTO strategy (
    id, name, type, is_active, timeframe,
    position_size, max_positions, slippage_percent, priority_fee_lamports,
    stop_loss_percent, take_profit_percent,
    trailing_stop, trailing_stop_percent, trailing_activation_percent,
    break_even_enabled, break_even_trigger_percent, break_even_offset_percent,
    partial_tp_enabled, tp1_percent, tp1_close_percent, tp2_percent, tp2_close_percent,
    time_stop_minutes, liquidity_exit_drop_percent,
    max_daily_loss, max_drawdown, cooldown_seconds,
    min_liquidity_usd, min_market_cap, max_market_cap,
    min_token_age_minutes, max_token_age_minutes,
    atr_period,
    dars_higher_tf, dars_candle_limit, dars_swing_pivot_pct, dars_require_htf_trend,
    dars_dominance_ratio, dars_min_correction_len_pct, dars_reject_at_resistance,
    dars_resistance_proximity_pct, dars_min_legs, dars_use_impulse_correction,
    dars_use_trend_levels, dars_use_false_breakout, dars_use_triangle,
    created_at, updated_at
) VALUES (
    ?, ?, ?, ?, ?,
    ?, ?, ?, ?,
    ?, ?,
    ?, ?, ?,
    ?, ?, ?,
    ?, ?, ?, ?, ?,
    ?, ?,
    ?, ?, ?,
    ?, ?, ?,
    ?, ?,
    ?,
    ?, ?, ?, ?,
    ?, ?, ?,
    ?, ?, ?,
    ?, ?, ?,
    ?, ?
);

updateActive:
UPDATE strategy SET is_active = ?, updated_at = ? WHERE id = ?;

-- Фильтр по диапазону не входит в insert/updateStrategy (там колонки берут DEFAULT) —
-- пишется отдельным запросом из StrategyStore.save, чтобы не трогать большой список колонок.
updateRangeParams:
UPDATE strategy SET
    range_filter_enabled = ?, range_max_entry_pct = ?, range_lookback_bars = ?
WHERE id = ?;

-- Параметры «Входа по баллу» — тоже вне insert/updateStrategy (колонки берут DEFAULT),
-- пишутся отдельным запросом из StrategyStore.save.
updateScoreParams:
UPDATE strategy SET
    score_threshold = ?, scan_filters_enabled = ?
WHERE id = ?;

-- Выключатели риск-лимитов — тоже вне insert/updateStrategy (колонки берут DEFAULT),
-- пишутся отдельным запросом из StrategyStore.save.
updateRiskToggles:
UPDATE strategy SET
    max_daily_loss_enabled = ?, max_drawdown_enabled = ?
WHERE id = ?;

-- Выходы в R — вне insert/updateStrategy (колонки берут DEFAULT), пишутся из StrategyStore.save.
updateExitParams:
UPDATE strategy SET
    r_ladder_enabled = ?, tp1_r = ?, tp2_r = ?, break_even_after_tp1 = ?,
    runner_enabled = ?, atr_trail_enabled = ?, atr_trail_mult = ?, atr_trail_activation_r = ?
WHERE id = ?;

-- Размер позиции от риска — тоже вне insert/updateStrategy.
updateSizingParams:
UPDATE strategy SET
    risk_sizing_enabled = ?, risk_per_trade_percent = ?, max_pool_share_percent = ?
WHERE id = ?;

-- Параметры «Пробой + откат» — тоже вне insert/updateStrategy.
updateBreakoutParams:
UPDATE strategy SET
    bp_higher_tf = ?, bp_require_htf_trend = ?, bp_breakout_lookback = ?, bp_breakout_volume_mult = ?,
    bp_max_bars_since_breakout = ?, bp_pullback_volume_ratio = ?, bp_trigger_volume_mult = ?
WHERE id = ?;

-- Выходы «по иксам» — тоже вне insert/updateStrategy.
updateTieredExitParams:
UPDATE strategy SET
    tiered_trail_enabled = ?, trail_tier1_pct = ?, trail_tier2_pct = ?, trail_tier3_pct = ?,
    trail_tier4_pct = ?, stale_exit_enabled = ?, stale_exit_minutes = ?
WHERE id = ?;

-- Параметры «Мем-плейбука» — тоже вне insert/updateStrategy.
updateMemeParams:
UPDATE strategy SET
    mp_lookback_bars = ?, mp_min_impulse_pct = ?, mp_fib_min = ?, mp_fib_max = ?,
    mp_pullback_volume_ratio = ?, mp_trigger_volume_mult = ?, mp_min_liq_to_mc_pct = ?,
    mp_require_revoked_authorities = ?, mp_reject_copycats = ?
WHERE id = ?;

-- Параметры «Волн Эллиотта» — тоже вне insert/updateStrategy.
updateElliottParams:
UPDATE strategy SET
    ew_higher_tf = ?, ew_require_htf = ?, ew_swing_atr = ?, ew_sub_degree = ?, ew_structure = ?,
    ew_trade_wave3 = ?, ew_trade_wave5 = ?, ew_trade_correction = ?,
    ew_w2_retrace_min = ?, ew_w2_retrace_max = ?, ew_w4_retrace_min = ?, ew_w4_retrace_max = ?,
    ew_min_guidelines = ?, ew_wave3_entry = ?, ew_entry_window_bars = ?, ew_stop_anchor = ?,
    ew_stop_buffer_atr = ?, ew_w3_target = ?, ew_w5_target = ?, ew_min_reward_risk = ?
WHERE id = ?;

-- Одноразовая нормализация уже засеянных Dars-стратегий к значениям методички
-- (Урок 4: коррекция ≥70% импульса; minLegs=4 для сравнения с прошлыми волнами;
-- доминирование 1.5×). Точечно: трогаем только строки, где осталась ровно старая
-- слабая тройка значений — пользовательские правки не затираем.
normalizeDarsDefaults:
UPDATE strategy SET
    dars_min_correction_len_pct = 70.0,
    dars_min_legs = 4,
    dars_dominance_ratio = 1.5,
    updated_at = ?
WHERE type = 'DARS'
    AND dars_min_correction_len_pct = 30.0
    AND dars_min_legs = 2
    AND dars_dominance_ratio = 1.3;

-- Одноразовая починка конфигов, где лимит просадки не больше стоп-лосса: в такой
-- конфигурации ЛЮБОЙ штатный выход по SL сразу упирается в лимит просадки и
-- блокирует стратегию. Поднимаем до двойного SL, пользовательские (корректные)
-- значения не трогаем.
normalizeDrawdownLimits:
UPDATE strategy SET
    max_drawdown = stop_loss_percent * 2.0,
    updated_at = ?
WHERE max_drawdown <= stop_loss_percent;

updateStrategy:
UPDATE strategy SET
    name = ?, type = ?, is_active = ?, timeframe = ?,
    position_size = ?, max_positions = ?, slippage_percent = ?, priority_fee_lamports = ?,
    stop_loss_percent = ?, take_profit_percent = ?,
    trailing_stop = ?, trailing_stop_percent = ?, trailing_activation_percent = ?,
    break_even_enabled = ?, break_even_trigger_percent = ?, break_even_offset_percent = ?,
    partial_tp_enabled = ?, tp1_percent = ?, tp1_close_percent = ?, tp2_percent = ?, tp2_close_percent = ?,
    time_stop_minutes = ?, liquidity_exit_drop_percent = ?,
    max_daily_loss = ?, max_drawdown = ?, cooldown_seconds = ?,
    min_liquidity_usd = ?, min_market_cap = ?, max_market_cap = ?,
    min_token_age_minutes = ?, max_token_age_minutes = ?,
    atr_period = ?,
    dars_higher_tf = ?, dars_candle_limit = ?, dars_swing_pivot_pct = ?, dars_require_htf_trend = ?,
    dars_dominance_ratio = ?, dars_min_correction_len_pct = ?, dars_reject_at_resistance = ?,
    dars_resistance_proximity_pct = ?, dars_min_legs = ?, dars_use_impulse_correction = ?,
    dars_use_trend_levels = ?, dars_use_false_breakout = ?, dars_use_triangle = ?,
    updated_at = ?
WHERE id = ?;

delete:
DELETE FROM strategy WHERE id = ?;

-- Стратегии Momentum Scalping и RSI+EMA удалены из бота — убираем их строки из старых БД
-- (иначе фабрика запустила бы неизвестный тип как Dars). Идемпотентно, из seedDefaultStrategies.
deleteRemovedTypes:
DELETE FROM strategy WHERE type IN ('MOMENTUM', 'RSI_EMA');

deleteAll:
DELETE FROM strategy;
