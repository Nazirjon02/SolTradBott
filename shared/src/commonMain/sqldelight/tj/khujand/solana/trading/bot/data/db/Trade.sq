CREATE TABLE IF NOT EXISTS trade (
    id TEXT NOT NULL PRIMARY KEY,
    strategy_id TEXT NOT NULL,
    strategy_name TEXT NOT NULL,
    mint TEXT NOT NULL,
    symbol TEXT NOT NULL,
    pair_address TEXT NOT NULL DEFAULT '',
    entry_price REAL NOT NULL,
    exit_price REAL,
    qty REAL NOT NULL,
    qty_remaining REAL NOT NULL,
    size_usd REAL NOT NULL,
    size_sol REAL NOT NULL DEFAULT 0,
    stop_loss REAL NOT NULL,
    take_profit REAL NOT NULL,
    peak_price REAL NOT NULL,
    tp1_done INTEGER NOT NULL DEFAULT 0,
    tp2_done INTEGER NOT NULL DEFAULT 0,
    entry_liquidity_usd REAL NOT NULL DEFAULT 0,
    pnl REAL,
    pnl_percent REAL,
    fee REAL,
    status TEXT NOT NULL DEFAULT 'OPEN',
    open_reason TEXT NOT NULL,
    close_reason TEXT,
    is_demo INTEGER NOT NULL DEFAULT 1,
    opened_at INTEGER NOT NULL,
    closed_at INTEGER,
    -- База для выходов в R (поздние колонки, пишутся setRiskBasis сразу после insert):
    -- начальный стоп (stop_loss потом двигают безубыток/трейлинг) и ATR/цена на входе.
    -- 0 = нет данных (старые сделки) — монитор берёт запасные значения из конфига.
    initial_stop REAL NOT NULL DEFAULT 0,
    entry_atr_frac REAL NOT NULL DEFAULT 0,
    -- Когда цена последний раз обновила пик (мс) — для выхода «нет нового максимума».
    -- Поздняя колонка, пишется updatePeak; 0 = нет данных (отсчёт от opened_at).
    peak_at INTEGER NOT NULL DEFAULT 0,
    -- Последняя цена, которую видел монитор: нереализованный PnL для лимитов портфеля
    -- без лишних запросов к API. 0 = ещё не обновлялась.
    last_price REAL NOT NULL DEFAULT 0,
    -- Неудачные попытки выхода подряд, время, раньше которого монитор не повторяет продажу,
    -- и причина последней неудачи. От EXIT_BLOCKED_AFTER подряд — «продажа заблокирована».
    exit_failures INTEGER NOT NULL DEFAULT 0,
    exit_retry_at INTEGER NOT NULL DEFAULT 0,
    exit_note TEXT NOT NULL DEFAULT '',
    -- Как исполнялась сделка: DEMO, SHADOW (DEMO по котировкам Jupiter) или REAL; '' — старые сделки.
    exec_mode TEXT NOT NULL DEFAULT ''
);

getAll:
SELECT * FROM trade ORDER BY opened_at DESC;

getOpenTrades:
SELECT * FROM trade WHERE status = 'OPEN';

getById:
SELECT * FROM trade WHERE id = ?;

getOpenCount:
SELECT COUNT(*) FROM trade WHERE strategy_id = ? AND status = 'OPEN';

getOpenCountTotal:
SELECT COUNT(*) FROM trade WHERE status = 'OPEN';

-- «Одна монета — одна сделка»: все mint'ы, по которым уже была сделка в этом режиме
-- (demo/real), независимо от статуса. Используется для пред-фильтра кандидатов сканера.
tradedMints:
SELECT DISTINCT mint FROM trade WHERE is_demo = ?;

-- Точечная перепроверка под локом перед входом: торговали ли уже этой монетой.
hasTradedMint:
SELECT COUNT(*) FROM trade WHERE mint = ? AND is_demo = ?;

insert:
INSERT INTO trade (
    id, strategy_id, strategy_name, mint, symbol, pair_address, entry_price, exit_price,
    qty, qty_remaining, size_usd, size_sol, stop_loss, take_profit, peak_price,
    tp1_done, tp2_done, entry_liquidity_usd, pnl, pnl_percent, fee,
    status, open_reason, close_reason, is_demo, opened_at, closed_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- status = 'OPEN' в WHERE — страховка от повторного закрытия: вторая запись по уже закрытой
-- сделке перетёрла бы цену выхода, PnL и время закрытия.
closeTrade:
UPDATE trade SET
    exit_price = ?, qty_remaining = 0, pnl = ?, pnl_percent = ?, fee = ?,
    status = 'CLOSED', close_reason = ?, closed_at = ?
WHERE id = ? AND status = 'OPEN';

updateStopLoss:
UPDATE trade SET stop_loss = ? WHERE id = ?;

-- Вне insert (колонки берут DEFAULT): пишется TradeExecutor'ом сразу после открытия.
setRiskBasis:
UPDATE trade SET initial_stop = ?, entry_atr_frac = ? WHERE id = ?;

updatePeak:
UPDATE trade SET peak_price = ?, peak_at = ? WHERE id = ?;

updateLastPrice:
UPDATE trade SET last_price = ? WHERE id = ?;

-- Вне insert (поздняя колонка): пишется TradeExecutor'ом вместе со строкой сделки.
setExecMode:
UPDATE trade SET exec_mode = ? WHERE id = ?;

-- Продажа не прошла: счётчик неудач подряд, когда пробовать снова и почему не вышло.
setExitFailure:
UPDATE trade SET exit_failures = ?, exit_retry_at = ?, exit_note = ? WHERE id = ? AND status = 'OPEN';

clearExitFailures:
UPDATE trade SET exit_failures = 0, exit_retry_at = 0, exit_note = '' WHERE id = ?;

-- Лимиты портфеля: открытые сделки текущего режима (demo/real) всех стратегий.
getOpenTradesByMode:
SELECT * FROM trade WHERE status = 'OPEN' AND is_demo = ?;

-- Реализованный PnL всех стратегий режима с момента (начало дня / неделя назад).
realizedPnlSince:
SELECT COALESCE(SUM(pnl), 0.0) FROM trade
WHERE status = 'CLOSED' AND is_demo = ? AND closed_at >= ?;

-- PnL закрытых сделок режима по времени закрытия (старые первыми) — кривая реализованного PnL
-- для просадки портфеля от пика.
closedPnlSince:
SELECT pnl FROM trade
WHERE status = 'CLOSED' AND is_demo = ? AND closed_at IS NOT NULL AND closed_at >= ?
ORDER BY closed_at ASC;

-- Последние закрытые сделки режима (новые первыми) — пауза после серии убытков.
recentClosed:
SELECT pnl, closed_at FROM trade
WHERE status = 'CLOSED' AND is_demo = ? AND closed_at IS NOT NULL
ORDER BY closed_at DESC LIMIT ?;

applyPartialClose:
UPDATE trade SET qty_remaining = ?, tp1_done = ?, tp2_done = ?, pnl = ?, fee = ? WHERE id = ? AND status = 'OPEN';

getTodayPnl:
SELECT COALESCE(SUM(pnl), 0.0) FROM trade
WHERE strategy_id = ? AND closed_at >= ? AND status = 'CLOSED';

getTodayPnlTotal:
SELECT COALESCE(SUM(pnl), 0.0) FROM trade
WHERE closed_at >= ? AND status = 'CLOSED';

-- Худшая закрытая сделка стратегии в СКОЛЬЗЯЩЕМ окне (closed_at >= ?).
-- Окно обязательно: без него одна плохая сделка блокировала бы стратегию навсегда,
-- т.к. история сделок не «рассасывается».
getMaxDrawdown:
SELECT COALESCE(MIN(pnl_percent), 0.0) FROM trade
WHERE strategy_id = ? AND status = 'CLOSED' AND closed_at >= ?;

getStats:
SELECT
    COUNT(*) AS total_trades,
    SUM(CASE WHEN pnl > 0 THEN 1 ELSE 0 END) AS wins,
    SUM(CASE WHEN pnl < 0 THEN 1 ELSE 0 END) AS losses,
    COALESCE(SUM(pnl), 0.0) AS total_pnl,
    COALESCE(SUM(fee), 0.0) AS total_fees
FROM trade WHERE status = 'CLOSED';

-- Итоги режима (demo/real) с момента — начало забега или дня (см. TradingRuns.kt).
getStatsByModeSince:
SELECT
    COUNT(*) AS total_trades,
    SUM(CASE WHEN pnl > 0 THEN 1 ELSE 0 END) AS wins,
    SUM(CASE WHEN pnl < 0 THEN 1 ELSE 0 END) AS losses,
    COALESCE(SUM(pnl), 0.0) AS total_pnl,
    COALESCE(SUM(fee), 0.0) AS total_fees
FROM trade WHERE status = 'CLOSED' AND is_demo = ? AND closed_at >= ?;

-- Закрытые сделки режима (старые первыми) — итоги забегов.
closedByMode:
SELECT strategy_name, pnl, fee, closed_at FROM trade
WHERE status = 'CLOSED' AND is_demo = ? AND closed_at IS NOT NULL
ORDER BY closed_at ASC;

getTodayStats:
SELECT
    COUNT(*) AS total_trades,
    SUM(CASE WHEN pnl > 0 THEN 1 ELSE 0 END) AS wins,
    SUM(CASE WHEN pnl < 0 THEN 1 ELSE 0 END) AS losses,
    COALESCE(SUM(pnl), 0.0) AS total_pnl
FROM trade WHERE status = 'CLOSED' AND closed_at >= ?;

deleteAll:
DELETE FROM trade;
